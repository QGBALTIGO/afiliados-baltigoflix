# Bot criado no @BotFather. Nunca publique este valor.
TELEGRAM_BOT_TOKEN=

# IDs numéricos dos administradores, separados por vírgula.
# Use /meuid no bot para descobrir o seu ID.
ADMIN_TELEGRAM_IDS=

# Mantenha false em produção para exigir aprovação administrativa.
AUTO_APPROVE_AFFILIATES=false

BRAND_NAME=Baltigo
SUPPORT_USERNAME=@seu_suporte
AFFILIATE_INVITE_URL=

# Depois de gerar o domínio no Railway, informe a URL completa.
PUBLIC_BASE_URL=https://seu-projeto.up.railway.app

ALLOWED_CHECKOUT_HOSTS=pay.cakto.com.br

# Informe somente o ID presente depois do domínio do checkout.
# Para aceitar mais de um checkout no mesmo plano, separe por vírgula.
CHECKOUT_MONTHLY=
CHECKOUT_QUARTERLY=
CHECKOUT_SEMIANNUAL=
CHECKOUT_ANNUAL=

PRICE_MONTHLY=20,90
PRICE_QUARTERLY=49,90
PRICE_SEMIANNUAL=79,90
PRICE_ANNUAL=119,90

COMMISSION_INITIAL=50%
COMMISSION_100=70%
COMMISSION_500=75%

HOST=0.0.0.0
PORT=8000
DB_PATH=./affiliate_pages.db
LOG_LEVEL=INFO
